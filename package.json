{
  "name": "@jscrawl/core",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "tsc -p tsconfig.build.json",
    "test:schema": "ts-node scripts/test-schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "author": "Weidong Fang",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fflate": "^0.8.3",
    "gumbo-html": "^3.4.0",
    "pg": "^8.23.1",
    "puppeteer": "^25.12.0",
    "robots-parser": "^3.0.1",
    "sqlex": "^5.0.0",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "yareq": "^3.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/xml2js": "^0.4.14",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "testRegex": "/test/.*\\.test\\.ts$",
    "setupFiles": [
      "<rootDir>/test/support/domain.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "verbose": true,
    "maxWorkers": 1
  },
  "description": "The crawl core: the engine, the operator surface and the agent tools; a domain app configures it (separate-core-app-impl.md).",
  "main": "./dist/core/domain.js",
  "types": "./dist/core/domain.d.ts",
  "exports": {
    "./extract": {
      "types": "./dist/core/extract/index.d.ts",
      "default": "./dist/core/extract/index.js"
    },
    "./mcp/*": {
      "types": "./dist/mcp/*.d.ts",
      "default": "./dist/mcp/*.js"
    },
    "./web/*": {
      "types": "./dist/web/*.d.ts",
      "default": "./dist/web/*.js"
    },
    "./entries/*": {
      "types": "./dist/entries/*.d.ts",
      "default": "./dist/entries/*.js"
    },
    "./*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    }
  },
  "files": [
    "dist",
    "etc/schema.sql",
    "etc/migrate-*.sql",
    "skills"
  ]
}
