{
  "name": "jscrawl",
  "version": "0.1.1",
  "description": "A domain-configurable crawl engine with an HTTP API and MCP tools.",
  "homepage": "https://github.com/fangwd/jscrawl#readme",
  "bugs": "https://github.com/fangwd/jscrawl/issues",
  "license": "MIT",
  "author": "Weidong Fang <wdfang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangwd/jscrawl.git"
  },
  "files": [
    "dist",
    "etc/schema.sql",
    "etc/migrate-*.sql",
    "skills"
  ],
  "main": "./dist/core/domain.js",
  "types": "./dist/core/domain.d.ts",
  "exports": {
    "./extract": {
      "types": "./dist/core/extract/index.d.ts",
      "default": "./dist/core/extract/index.js"
    },
    "./mcp/*": {
      "types": "./dist/mcp/*.d.ts",
      "default": "./dist/mcp/*.js"
    },
    "./web/*": {
      "types": "./dist/web/*.d.ts",
      "default": "./dist/web/*.js"
    },
    "./entries/*": {
      "types": "./dist/entries/*.d.ts",
      "default": "./dist/entries/*.js"
    },
    "./*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "tsc -p tsconfig.build.json",
    "test:schema": "ts-node scripts/test-schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "check:format": "oxfmt --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fflate": "^0.8.3",
    "gumbo-html": "^3.4.0",
    "pg": "^8.23.1",
    "puppeteer": "^25.12.0",
    "robots-parser": "^3.0.1",
    "sqlex": "^5.0.1",
    "systeminformation": "^5.33.19",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "yareq": "^3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/xml2js": "^0.4.14",
    "jest": "^30.5.2",
    "oxfmt": "^0.78.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "maxWorkers": 1,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFiles": [
      "<rootDir>/test/support/domain.ts"
    ],
    "testRegex": "/test/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "verbose": true
  }
}
